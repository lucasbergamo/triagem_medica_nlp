# PDFs e documentos
*.pdf
*.docx

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Dados — bronze é comitado intencionalmente (CSV público, ~18MB, sem DVC — o volume não
# justifica a dependência extra, e garante que um clone reproduza os dados offline).
# silver/gold são derivados, regenerados por `make data`.
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep

# Modelos treinados — artefatos, não código
models/*
!models/.gitkeep
!models/current
models/current/*
!models/current/.gitkeep
models/staging/

# Métricas geradas por treino/avaliação/benchmark — exceto a baseline de latência, que é a
# referência versionada contra a qual as medições dos backends ONNX vão comparar.
metrics/*
!metrics/.gitkeep
!metrics/latency_baseline.json

# Airflow — estado local, nunca commitado
airflow/.env
airflow/logs/

# IDEs
.vscode/
.idea/
*.code-workspace

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Variáveis de ambiente
.env
.env.local
.env.*.local
secrets.yaml
# .env.example deve ser commitado — é o template público

# Pre-commit
.pre-commit-cache/

# Cobertura de testes
.coverage
htmlcov/
coverage.xml

# Ruff / pytest
.ruff_cache/
.pytest_cache/

# Terraform — state contém dados sensíveis e é específico da conta AWS
# (.terraform.lock.hcl NÃO entra aqui — fixa a versão exata do provider, mesmo
# princípio do poetry.lock)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfvars
infra/crash.log
infra/tfplan
