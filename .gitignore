# PDFs e documentos
*.pdf
*.docx

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Dados — bronze é comitado intencionalmente (CSV público, ~18MB, sem DVC — o volume não
# justifica a dependência extra, e garante que um clone reproduza os dados offline).
# silver/gold são derivados, regenerados por `make data`.
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep

# Modelos treinados — artefatos, não código
models/*
!models/.gitkeep
!models/current
models/current/*
!models/current/.gitkeep
models/staging/

# Métricas geradas por treino/avaliação/benchmark — exceto a baseline de latência (referência
# versionada contra a qual as medições dos backends ONNX comparam) e o benchmark comparativo
# dos 3 backends, que é a evidência por trás da tabela de docs/latencia.md e do README.
metrics/*
!metrics/.gitkeep
!metrics/latency_baseline.json
!metrics/latency_benchmark.json

# Airflow — estado local, nunca commitado. airflow/logs/ é exceção parcial: a pasta em si
# precisa existir no clone (senão o Docker a cria como root no primeiro `docker compose up`,
# e o container, rodando com o uid do host, não consegue escrever nela) — só o conteúdo é
# ignorado.
airflow/.env
airflow/logs/*
!airflow/logs/.gitkeep

# IDEs
.vscode/
.idea/
*.code-workspace

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Instruções para sessões de IA — ferramenta de desenvolvimento, não entregável.
# O arquivo continua no disco para as sessões lerem; a cópia arquivada vive fora deste repo.
CLAUDE.md

# Variáveis de ambiente
.env
.env.local
.env.*.local
secrets.yaml
# .env.example deve ser commitado — é o template público

# Pre-commit
.pre-commit-cache/

# Cobertura de testes
.coverage
htmlcov/
coverage.xml

# Ruff / pytest
.ruff_cache/
.pytest_cache/

# Terraform — state contém dados sensíveis e é específico da conta AWS
# (.terraform.lock.hcl NÃO entra aqui — fixa a versão exata do provider, mesmo
# princípio do poetry.lock)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfvars
infra/crash.log
infra/tfplan
