# Copie para airflow/.env e preencha. Valores apenas para ambiente local.

# Metadata DB do Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

# UID do usuário que roda os containers (Linux/WSL: saída de `id -u`). Os alvos `make
# airflow-*` já exportam isso automaticamente com o uid de quem chama o make — só preencha
# aqui se for rodar `docker compose` direto, sem passar pelo Makefile. Deixar o default abaixo
# (50000, o uid do container) faz os artefatos que a DAG escreve em data/, models/ e metrics/
# saírem com dono diferente do seu usuário no host.
AIRFLOW_UID=50000

# Usuário admin da UI
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Gerar cada um: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API__SECRET_KEY=
