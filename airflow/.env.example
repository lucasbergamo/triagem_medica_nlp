# Copie para airflow/.env. `make airflow-up` faz isso sozinho na primeira subida e ainda
# preenche as chaves criptográficas vazias lá embaixo. Valores apenas para ambiente local:
# nenhum serviço desta stack é exposto para fora da máquina.

# Metadata DB do Airflow. Senha fixa de propósito: o Postgres só lê POSTGRES_PASSWORD quando
# inicializa um diretório de dados vazio, então uma senha gerada a cada `airflow/.env` novo
# quebraria o login no banco sempre que alguém regerasse o arquivo com o volume ainda de pé
# (`password authentication failed for user "airflow"`). O banco só escuta na rede interna do
# compose, sem porta publicada no host.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_local
POSTGRES_DB=airflow

# UID do usuário que roda os containers (Linux/WSL: saída de `id -u`). Os alvos `make
# airflow-*` já exportam isso automaticamente com o uid de quem chama o make — só preencha
# aqui se for rodar `docker compose` direto, sem passar pelo Makefile. Deixar o default abaixo
# (50000, o uid do container) faz os artefatos que a DAG escreve em data/, models/ e metrics/
# saírem com dono diferente do seu usuário no host.
AIRFLOW_UID=50000

# Usuário admin da UI em localhost:8080. Mesmas credenciais do Grafana, pelo mesmo motivo:
# são as duas interfaces que uma pessoa avaliando o projeto abre no navegador, e uma senha
# aleatória aqui só adiciona um passo de procurar em arquivo antes de ver a DAG rodando.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Chaves criptográficas do Airflow. Ficam vazias no exemplo e são geradas automaticamente por
# `scripts/gen_airflow_env.py` ao criar o `airflow/.env`: ninguém precisa digitá-las, então
# não há motivo para versionar um valor fixo. Para preencher à mão:
#   FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   os dois abaixo: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API__SECRET_KEY=
